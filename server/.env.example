# بک‌اند: این فایل را با نام server/.env کپی کنید
# روی Render این را ننویسید (Render خودش در زمان اجرا production می‌گذارد)
# NODE_ENV=production
PORT=8787

# حداقل ۳۲ حرف تصادفی. برای ساخت:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# فقط اگر سایت روی آدرس جدایی است (Netlify/Vercel): آدرس سایت را اینجا بنویسید (چند آدرس را با ویرگول جدا کنید)
# ALLOWED_ORIGINS=https://yaqin-code.netlify.app
# PUBLIC_URL=https://your-backend.example.com

# اختیاری: ساخت خودکار ادمین بدون فرم مرورگر
# ADMIN_USERNAME=yaqin
# ADMIN_PASSWORD=

# پشت پروکسی میزبان (Render، Railway، nginx) بگذارید 1
TRUST_PROXY=1

# پوشه‌ی دیتابیس و عکس‌ها؛ باید دیسک ماندگار باشد
# DATA_DIR=/var/data
